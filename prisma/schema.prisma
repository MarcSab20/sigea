// SIGEA — Schéma Prisma principal

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Organisation et habilitations
// ═══════════════════════════════════════════════════════════════════════════

enum RoleUtilisateur {
  /// Commandant de base. Planifie, puis arrête la liste avant émission du manifeste.
  combase
  /// Commandant d'escadron aérien. Planifie au départ de sa base.
  comea
  /// Sous-chef opérations. Vue nationale. Alloue les quotas et diffuse.
  scops
  /// Commandant de Région Militaire Interarmées. Signature numérique.
  comrmia
  /// Adjoint Air au COMRMIA. VU numérique.
  adj_air
  /// Secrétaire de l'Adjoint Air. SEUL rôle habilité à SAISIR.
  sec_adj_air
  /// Commandant en second de base. Délégataire possible du COMBASE.
  comsecbase
  /// Délégataire possible du COMBASE.
  comgmo
  /// Commandant de bord. Dernière discrimination, seul visa du manifeste.
  combord
  /// Autorité centrale. Espace conservé pour les impositions d'urgence.
  cemaa
  mage
  admin
}

enum Rmia {
  /// Centre, Sud, Est
  RMIA_1
  /// Littoral, Sud-Ouest
  RMIA_2
  /// Nord, Adamaoua
  RMIA_3
  /// Extrême-Nord
  RMIA_4
  /// Ouest, Nord-Ouest
  RMIA_5
}

// ═══════════════════════════════════════════════════════════════════════════
// Cycle de vie
// ═══════════════════════════════════════════════════════════════════════════

enum StatutVol {
  /// Créé, NON diffusé. Visible du créateur, de sa base et du SCOPS.
  PLANIFIE
  /// Quotas alloués. Visible des RMIA touchées.
  DIFFUSE
  EN_COURS
  CLOTURE
  ANNULE
}

/// Étapes du circuit d'une liste. L'ordre métier est porté par
/// ETAPE_LISTE_SEQUENCE (@sigea/shared-types), PAS par cette déclaration.
enum EtapeListe {
  SEC_ADJ_AIR
  ADJ_AIR
  COMRMIA
  COMBASE
  COMBORD
}

enum StatutListe {
  /// Quota alloué, saisie en cours. Aucun visa apposé.
  OUVERTE
  /// Circuit engagé.
  EN_VALIDATION
  /// Arrêtée par le COMBASE : manifeste émis, messages partis.
  ARRETEE
  /// Visée par le COMBORD : manifeste définitif.
  CLOTUREE
  /// Renvoyée en arrière.
  REJETEE
}

enum NatureLigne {
  HIERARCHISEE
  ATTENTE
  /// Retirée par une autorité. Conservée pour tracer la décision, jamais
  /// imprimée, jamais comptée dans un quota.
  RETIREE
}

enum Priorite {
  P1
  P2
  P3
  P4
  P5
  P6
}

enum StatutPotentialite {
  DISPONIBLE
  RETENUE
  ARCHIVEE
}

/// Mention portée par une signature numérique. Enum UNIQUE de l'application :
/// elle sert aux visas de liste comme au visa du manifeste.
enum MentionVisa {
  /// SEC_ADJ_AIR et ADJ_AIR.
  VU
  /// COMRMIA.
  SIGNATURE
  /// COMBASE — acte de commandement.
  ACCORD
  /// COMBORD — visa unique du manifeste.
  VISA
}

enum StatutManifeste {
  /// Émis à l'arrêté du COMBASE, en attente du visa du commandant de bord.
  EMIS
  /// Visé par le COMBORD. Document opposable.
  DEFINITIF
  ANNULE
}

enum StatutMessage {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum OrigineEnregistrement {
  /// Saisie par le secrétaire de l'Adjoint Air.
  SAISIE
  /// Imposée en urgence par le CEMAA.
  CEMAA
  /// Imposée en urgence par le MAGE.
  MAGE
}

enum AutoriteCentrale {
  CEMAA
  MAGE
}

enum CategoriePassager {
  TROUPES
  TROUPES_PARA
  CHEF_MIL
  MISSION
  PERMISSION
  EVASAN
  VIP
  CIVIL
  OP_SENSIBLE
}

enum TypeMission {
  PROJECTION
  PARA
  LIAISON
  LOGISTIQUE
  EVASAN
  VIP
  OP_SENSIBLE
}

enum TypeConsigne {
  PERSONNEL
  MATERIEL
}

enum TypeMissionLogistique {
  AA
  IA
  INTERMINISTERIEL
  INDIVIDUEL
  SENSIBLE_CEMAA
}

enum FonctionEquipage {
  COMBORD
  COPILOTE
  MECANICIEN
  AUTRE
}

enum TypeMouvement {
  MUTATION
  DEPART
  SUSPENSION
  REINTEGRATION
}

enum StatutConsigne {
  EMISE
  REALISEE
  NON_REALISEE
  ANNULEE
}

enum StatutArchive {
  DISPONIBLE
  ABSENT
  CORROMPU
}

enum TypeNotification {
  VOL_DIFFUSE
  LISTE_A_TRAITER
  LISTE_VISEE
  LISTE_REJETEE
  LISTE_ARRETEE
  MANIFESTE_DEFINITIF
  CONSIGNE_AUTORITE
  ALERTE
}

// ═══════════════════════════════════════════════════════════════════════════
// Référentiel
// ═══════════════════════════════════════════════════════════════════════════

model Base {
  id        String @id @default(uuid())
  code_base String @unique
  numero    String
  nom       String
  region    String

  /// RMIA de rattachement. STOCKÉE et non dérivée de `region` à la lecture :
  /// elle porte le cloisonnement, et un cloisonnement ne doit pas dépendre
  /// d'une chaîne saisie à la main.
  rmia Rmia

  admin_id       String?
  administrateur Utilisateur? @relation("BaseAdmin", fields: [admin_id], references: [id])

  utilisateurs      Utilisateur[]
  manifestes        Manifeste[]
  vols_depart       Vol[]             @relation("VolDepart")
  vols_arrivee      Vol[]             @relation("VolArrivee")
  etapes_itineraire EtapeItineraire[] @relation("EtapeBase")
  escadrons         Escadron[]
  notifications     Notification[]
  potentialites     Potentialite[]
  createdAt         DateTime          @default(now())

  @@index([rmia])
}

model Escadron {
  id      String  @id @default(uuid())
  code    String
  nom     String
  type    String?
  base_id String
  base    Base    @relation(fields: [base_id], references: [id])
  actif   Boolean @default(true)

  utilisateurs Utilisateur[]
  vols         Vol[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([base_id, code])
  @@index([base_id, actif])
}

model Aeronef {
  id                String   @id @default(uuid())
  immatriculation   String   @unique
  type              String
  capacite_places   Int
  capacite_cargo_kg Decimal  @db.Decimal(10, 2)
  actif             Boolean  @default(true)
  vols              Vol[]
  createdAt         DateTime @default(now())
}

model Unite {
  id   String @id @default(uuid())
  code String @unique
  nom  String
  type String
}

// ═══════════════════════════════════════════════════════════════════════════
// Utilisateurs
// ═══════════════════════════════════════════════════════════════════════════

model Utilisateur {
  id            String          @id @default(uuid())
  nom           String
  prenom        String
  grade         String
  login         String          @unique
  password_hash String
  role          RoleUtilisateur

  /// Base d'affectation administrative. Ne commande PAS le périmètre des rôles
  /// RMIA ni des rôles nationaux — voir `rmia` et `perimetreDeRole()`.
  base_id String
  base    Base   @relation(fields: [base_id], references: [id])

  /// OBLIGATOIRE pour comrmia / adj_air / sec_adj_air, NULLE ailleurs.
  /// Seul ce champ interdit à l'Adjoint Air de la RMIA 2 de voir les listes
  /// de la RMIA 4.
  rmia Rmia?

  escadron_id String?
  escadron    Escadron? @relation(fields: [escadron_id], references: [id])

  base_admin Base[]  @relation("BaseAdmin")
  actif      Boolean @default(true)

  vols_combord       Vol[]                  @relation("VolCombord")
  sessions           Session[]
  visas              VisaListe[]            @relation("VisaSignataire")
  delegations_recues VisaListe[]            @relation("VisaDelegataire")
  audits             AuditLog[]
  otp_secret         OtpSecret?
  challenge_token    ChallengeToken?
  email              String?
  telephone          String?
  mfa_enrolled       Boolean                @default(false)
  verrouille_securite Boolean               @default(false)
  motif_verrouillage String?
  nb_echecs_connexion Int                   @default(0)
  last_login         DateTime?
  last_login_ip      String?
  last_login_at      DateTime?
  notif_connexion    Boolean                @default(true)
  notif_par_email    Boolean                @default(false)
  backup_codes       BackupCode[]
  known_devices      KnownDevice[]
  security_notifs    SecurityNotification[]
  mfa_reset_requests MfaResetRequest[]
  notifications      Notification[]
  interims_titulaire Interim[]              @relation("InterimTitulaire")
  interims_suppleant Interim[]              @relation("InterimSuppleant")
  mouvements         MouvementPersonnel[]   @relation("MouvementConcerne")
  successions        MouvementPersonnel[]   @relation("MouvementSuccesseur")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([base_id, role])
  @@index([rmia, role])
  @@index([escadron_id])
}

model OtpSecret {
  id          String      @id @default(uuid())
  user_id     String      @unique
  secret      String
  actif       Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("otp_secrets")
}

model ChallengeToken {
  id          String      @id @default(uuid())
  user_id     String      @unique
  token       String      @unique
  expires_at  DateTime
  created_at  DateTime    @default(now())
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("challenge_tokens")
}

model Session {
  id             String      @id @default(uuid())
  utilisateur_id String
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id])
  refresh_hash   String
  expires_at     DateTime
  createdAt      DateTime    @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// Vol et itinéraire
// ═══════════════════════════════════════════════════════════════════════════

model Vol {
  id              String   @id @default(uuid())
  numero_mission  String   @unique
  immatriculation String
  aeronef         Aeronef  @relation(fields: [immatriculation], references: [immatriculation])
  date_heure      DateTime

  /// Raccourcis dénormalisés : ordre 1 et ordre n de l'itinéraire.
  /// Écrits par vol-service, jamais saisis.
  base_depart_id  String
  base_depart     Base   @relation("VolDepart", fields: [base_depart_id], references: [id])
  base_arrivee_id String
  base_arrivee    Base   @relation("VolArrivee", fields: [base_arrivee_id], references: [id])

  type_mission  TypeMission
  flag_sensible Boolean     @default(false)

  /// Plafond absolu. Aucun quota d'étape ne peut le dépasser.
  capacite_places   Int
  capacite_cargo_kg Decimal @db.Decimal(10, 2)

  /// Commandant de bord désigné. OBLIGATOIRE : sans compte rattaché, le visa
  /// final ne peut être attribué et le manifeste reste à l'état EMIS.
  combord_id     String
  combord        Utilisateur @relation("VolCombord", fields: [combord_id], references: [id])
  combord_grade  String
  combord_nom    String
  combord_prenom String

  cree_par    String
  escadron_id String?
  escadron    Escadron? @relation(fields: [escadron_id], references: [id])

  statut StatutVol @default(PLANIFIE)

  diffuse_par String?
  diffuse_le  DateTime?

  itineraire      EtapeItineraire[]
  listes          ListeEmbarquement[]
  manifestes      Manifeste[]
  consignes       ConsigneAutorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut, date_heure])
  @@index([base_depart_id, date_heure])
  @@index([cree_par])
  @@index([combord_id, statut])
}

/// Point de l'itinéraire, ordre 1..n. L'ordre 1 est la base de départ.
///
/// AUCUNE unicité sur (vol_id, base_id) : un itinéraire peut repasser par la
/// même base — cas nominal de l'aller-retour Yaoundé → Douala → Garoua →
/// Douala → Yaoundé, que l'ancien modèle rejetait.
model EtapeItineraire {
  id     String @id @default(uuid())
  vol_id String
  vol    Vol    @relation(fields: [vol_id], references: [id], onDelete: Cascade)

  ordre   Int
  base_id String
  base    Base   @relation("EtapeBase", fields: [base_id], references: [id])

  /// RMIA figée à la création. Permet d'indexer la diffusion sans joindre Base,
  /// et de savoir des années plus tard quelle RMIA était compétente.
  rmia Rmia

  /// Quota d'EMBARQUEMENT alloué par le SCOPS. NULL tant qu'il n'a pas statué :
  /// l'absence de valeur distingue « pas encore alloué » de « rien alloué ».
  /// Toujours NULL sur le dernier point — personne n'y embarque.
  quota_places   Int?
  quota_masse_kg Decimal? @db.Decimal(10, 2)

  quota_alloue_par String?
  quota_alloue_le  DateTime?

  heure_arrivee DateTime?
  heure_depart  DateTime?

  listes     ListeEmbarquement[]
  manifestes Manifeste[]

  createdAt DateTime @default(now())

  @@unique([vol_id, ordre])
  @@index([base_id])
  @@index([rmia, vol_id])
  @@map("etape_itineraire")
}

// ═══════════════════════════════════════════════════════════════════════════
// Potentialités — vivier tenu par le secrétaire de l'Adjoint Air
// ═══════════════════════════════════════════════════════════════════════════

/// Voyageur potentiel, enregistré hors de tout vol.
/// Un enregistrement n'emporte AUCUN droit à embarquer.
model Potentialite {
  id      String @id @default(uuid())
  rmia    Rmia
  base_id String
  base    Base   @relation(fields: [base_id], references: [id])

  nom       String
  prenom    String
  grade     String?
  matricule String?
  cni       String?
  unite     String?
  telephone String
  categorie CategoriePassager

  /// Priorité proposée. Indicative : l'ADJ_AIR et le COMRMIA la révisent sur
  /// la liste, sans modifier la potentialité.
  priorite_proposee Priorite @default(P4)

  destination_souhaitee String?
  motif                 String?
  ref_autorisation      String?

  nb_bagages       Int     @default(0)
  masse_bagages_kg Decimal @default(0) @db.Decimal(7, 2)

  contact_urgence_nom  String?
  contact_urgence_tel  String?
  contact_urgence_qual String?

  statut         StatutPotentialite @default(DISPONIBLE)
  enregistre_par String
  /// Péremption du vivier : un demandeur de l'an dernier n'est pas un candidat.
  valable_jusqu_au DateTime?

  lignes LigneListe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rmia, statut])
  @@index([base_id, statut])
  @@index([nom, prenom])
  @@index([matricule])
  @@index([cni])
}

// ═══════════════════════════════════════════════════════════════════════════
// Listes d'embarquement
// ═══════════════════════════════════════════════════════════════════════════

/// Liste d'un point d'embarquement donné, d'un vol donné.
/// Un vol traversant trois RMIA produit trois listes indépendantes.
model ListeEmbarquement {
  id     String @id @default(uuid())
  vol_id String
  vol    Vol    @relation(fields: [vol_id], references: [id], onDelete: Cascade)

  etape_id String
  etape    EtapeItineraire @relation(fields: [etape_id], references: [id], onDelete: Cascade)

  rmia Rmia

  statut         StatutListe @default(OUVERTE)
  etape_courante EtapeListe? @default(SEC_ADJ_AIR)
  version        Int         @default(1)

  /// Quota opposable, RECOPIÉ de l'étape à l'ouverture. Une jointure donnerait
  /// la valeur courante : un réajustement du SCOPS changerait alors la capacité
  /// d'une liste déjà visée, sous les pieds de ses signataires.
  quota_places   Int
  quota_masse_kg Decimal @db.Decimal(10, 2)

  /// Motif du dernier renvoi en arrière. Effacé au visa suivant.
  motif_rejet String?

  lignes    LigneListe[]
  frets     FretListe[]
  visas     VisaListe[]
  snapshots ListeSnapshot[]
  messages  MessageVoyageur[]
  manifeste Manifeste?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vol_id, etape_id])
  @@index([rmia, statut])
  @@index([etape_courante])
}

/// Une ligne de liste : un voyageur, sa priorité, son rang, son trajet.
model LigneListe {
  id       String            @id @default(uuid())
  liste_id String
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id], onDelete: Cascade)

  potentialite_id String?
  potentialite    Potentialite? @relation(fields: [potentialite_id], references: [id])

  nature   NatureLigne @default(HIERARCHISEE)
  priorite Priorite    @default(P4)
  /// Rang au sein de (liste, nature, priorité) : ordre d'impression et d'appel.
  rang     Int

  // ── Identité, RECOPIÉE de la potentialité et figée ──
  // La liste est un acte : si le secrétaire corrige une faute de frappe dans le
  // vivier après signature de l'ADJ_AIR, le document signé ne doit pas changer.
  nom       String
  prenom    String
  grade     String?
  matricule String?
  cni       String?
  unite     String?
  telephone String
  categorie CategoriePassager

  // ── Trajet, en ordres d'itinéraire ──
  /// Point d'embarquement : l'ordre de l'étape porteuse de la liste.
  embarquement_ordre Int
  /// Strictement supérieur. L'intervalle [embarquement, debarquement)
  /// détermine les tronçons occupés, donc la place consommée aux escales.
  debarquement_ordre Int
  destination        String

  nb_bagages       Int     @default(0)
  masse_bagages_kg Decimal @default(0) @db.Decimal(7, 2)
  couleur_bagages  String?

  contact_urgence_nom  String?
  contact_urgence_tel  String?
  contact_urgence_qual String?
  ref_autorisation     String?

  /// Origine de l'enregistrement. CEMAA ou MAGE = imposition d'urgence :
  /// la ligne est verrouillée dès sa création et échappe à la discrimination.
  origine    OrigineEnregistrement @default(SAISIE)
  saisie_par String

  discrimine_par   String?
  discrimine_etape EtapeListe?
  motif_decision   String?

  /// Verrou posé à l'arrêté du COMBASE, ou dès la création pour une imposition
  /// d'autorité centrale.
  verrouille Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liste_id, nature, priorite, rang])
  @@index([liste_id, nature, priorite, rang])
  @@index([liste_id, embarquement_ordre, debarquement_ordre])
  @@index([potentialite_id])
}

/// Fret porté par une liste.
///
/// Sans lui, le quota en kilos alloué par le SCOPS ne couvrirait que les bagages
/// de cabine : une palette de 800 kg passerait hors quota. Le fret occupe les
/// mêmes tronçons qu'un passager, et se compte dans la même masse.
model FretListe {
  id       String            @id @default(uuid())
  liste_id String
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id], onDelete: Cascade)

  designation      String
  type_mission_log TypeMissionLogistique
  proprietaire     String
  poids_kg         Decimal  @db.Decimal(10, 2)
  volume           Decimal? @db.Decimal(10, 3)

  embarquement_ordre Int
  debarquement_ordre Int
  destination        String

  expediteur_nom      String
  expediteur_fonction String
  expediteur_tel      String

  /// Matière dangereuse : classe IATA renseignée si et seulement si applicable.
  classe_iata     String?
  conditionnement String?

  retire         Boolean     @default(false)
  discrimine_par String?
  motif_decision String?

  origine    OrigineEnregistrement @default(SAISIE)
  saisie_par String
  verrouille Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liste_id, retire])
  @@index([liste_id, embarquement_ordre, debarquement_ordre])
}

/// Signature numérique apposée sur une liste — ou, à l'étape COMBORD, sur le
/// manifeste qui en est issu. Contenu figé à la signature.
model VisaListe {
  id       String            @id @default(uuid())
  liste_id String
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id], onDelete: Cascade)

  etape   EtapeListe
  mention MentionVisa

  signataire_id     String?
  signataire        Utilisateur? @relation("VisaSignataire", fields: [signataire_id], references: [id])
  signataire_nom    String
  signataire_prenom String
  signataire_grade  String
  /// Qualité imprimée sous la signature : « ADJOINT AIR / RMIA 2 ».
  /// Figée : une mutation ne doit pas réécrire la qualité sous laquelle on a signé.
  signataire_titre  String

  // ── Délégation (étape COMBASE uniquement) ──
  // Le COMBASE peut faire discriminer par le COMGMO ou le COMSECBASE. La
  // signature IMPRIMÉE reste la sienne ; la note de délégation n'est pas
  // imprimée mais conservée pour l'archivage. D'où deux colonnes distinctes.
  delegataire_id    String?
  delegataire       Utilisateur? @relation("VisaDelegataire", fields: [delegataire_id], references: [id])
  delegataire_nom   String?
  delegataire_grade String?
  note_delegation   String?

  // ── Intérim ──
  par_interim     Boolean  @default(false)
  interim_id      String?
  interim         Interim? @relation(fields: [interim_id], references: [id])
  titulaire_nom   String?
  titulaire_grade String?

  /// SHA-256 du contenu visé. Répond à « sur QUOI cette signature a porté »,
  /// ce que la seule date ne dit pas.
  hash_contenu    String
  version_contenu Int

  commentaire String?
  date_heure  DateTime @default(now())

  @@unique([liste_id, etape], name: "liste_id_etape")
  @@index([liste_id, date_heure])
  @@index([signataire_id])
}

/// Instantané immuable du contenu d'une liste, figé à chaque visa.
/// Aucune écriture après création.
model ListeSnapshot {
  id       String            @id @default(uuid())
  liste_id String
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id], onDelete: Cascade)

  /// Les passages répétés sur une même étape (rejet, correction, nouveau rejet)
  /// sont suffixés « ETAPE#1 », « ETAPE#2 » pour ne pas s'écraser.
  etape           String
  version_contenu Int
  version_format  Int    @default(1)
  hash            String
  payload         String

  signataire_id String?
  createdAt     DateTime @default(now())

  @@unique([liste_id, etape], name: "liste_id_etape")
  @@index([liste_id, createdAt])
  @@index([hash])
}

/// Message pratique adressé à un voyageur retenu, via passerelle opérateur.
/// Émis à l'arrêté du COMBASE : les noms sont stabilisés, l'heure est connue.
model MessageVoyageur {
  id       String            @id @default(uuid())
  liste_id String
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id], onDelete: Cascade)
  ligne_id String

  telephone String
  contenu   String        @db.VarChar(640)
  statut    StatutMessage @default(EN_ATTENTE)

  /// Référence rendue par l'opérateur : seule preuve de prise en charge.
  operateur_ref   String?
  nb_tentatives   Int     @default(0)
  derniere_erreur String?
  envoye_le       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut, createdAt])
  @@index([liste_id])
  @@index([ligne_id])
}

// ═══════════════════════════════════════════════════════════════════════════
// Manifeste — extrait de la liste hiérarchisée, visé par le seul COMBORD
// ═══════════════════════════════════════════════════════════════════════════

model Manifeste {
  id     String @id @default(uuid())
  vol_id String
  vol    Vol    @relation(fields: [vol_id], references: [id])

  base_id String
  base    Base   @relation(fields: [base_id], references: [id])

  /// Liste dont ce manifeste est l'extrait. Relation 1-1 obligatoire : un
  /// manifeste sans liste serait un document sans circuit de validation.
  liste_id String            @unique
  liste    ListeEmbarquement @relation(fields: [liste_id], references: [id])

  etape_id String
  etape    EtapeItineraire @relation(fields: [etape_id], references: [id])

  numero_manifeste String  @unique
  version          Int     @default(1)
  statut           StatutManifeste @default(EMIS)
  flag_sensible    Boolean @default(false)

  emis_par       String
  emis_le        DateTime  @default(now())
  definitif_le   DateTime?

  passagers       Passager[]
  materiels       Materiel[]
  equipages       Equipage[]
  snapshots       ManifesteSnapshot[]
  archive         ArchiveManifeste?
  numero_controle NumeroControle?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([base_id, statut])
  @@index([vol_id])
}

model Passager {
  id           String    @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id      String

  /// Ligne de liste d'origine : permet de remonter du manifeste à la décision
  /// qui a porté ce nom à bord.
  ligne_liste_id String
  priorite       Priorite
  rang           Int

  nom       String
  prenom    String
  grade     String?
  categorie CategoriePassager
  matricule String?
  cni       String?
  unite     String?
  telephone String

  destination        String
  debarquement_ordre Int

  nb_bagages           Int
  masse_bagages_kg     Decimal @db.Decimal(7, 2)
  couleur_bagages      String?
  contact_urgence_nom  String?
  contact_urgence_tel  String?
  contact_urgence_qual String?
  ref_autorisation     String?

  origine OrigineEnregistrement @default(SAISIE)
  /// Retiré par le commandant de bord lors de sa discrimination finale.
  /// Conservé plutôt que supprimé : le retrait est une décision, et elle se trace.
  retire         Boolean @default(false)
  motif_retrait  String?

  createdAt DateTime @default(now())

  @@index([manifeste_id, retire])
  @@index([ligne_liste_id])
  @@index([cni])
  @@index([matricule])
}

model Materiel {
  id           String    @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id      String

  fret_liste_id String

  designation         String
  type_mission_log    TypeMissionLogistique
  proprietaire        String
  poids_kg            Decimal  @db.Decimal(10, 2)
  volume              Decimal? @db.Decimal(10, 3)
  destination         String
  debarquement_ordre  Int
  expediteur_nom      String
  expediteur_fonction String
  expediteur_tel      String
  classe_iata         String?
  conditionnement     String?

  origine       OrigineEnregistrement @default(SAISIE)
  retire        Boolean               @default(false)
  motif_retrait String?

  createdAt DateTime @default(now())

  @@index([manifeste_id, retire])
  @@index([fret_liste_id])
}

model Equipage {
  id           String           @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste        @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id      String
  nom          String
  prenom       String
  grade        String
  fonction     FonctionEquipage
}

model ManifesteSnapshot {
  id           String    @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)

  etape           String
  version_contenu Int
  version_format  Int    @default(1)
  hash            String
  payload         String

  signataire_id String?
  createdAt     DateTime @default(now())

  @@unique([manifeste_id, etape], name: "manifeste_id_etape")
  @@index([manifeste_id, createdAt])
  @@index([hash])
}

// ═══════════════════════════════════════════════════════════════════════════
// Autorités centrales — espace conservé pour les cas d'urgence
// ═══════════════════════════════════════════════════════════════════════════

/// Consigne du CEMAA ou du MAGE sur un vol.
///
/// Deux usages, et ils ne se confondent pas :
///   • BLOCAGE de places ou de masse, que le SCOPS doit respecter ;
///   • IMPOSITION d'un embarquement, matérialisée par une LigneListe d'origine
///     CEMAA ou MAGE, verrouillée, hors discrimination.
///
/// Dans les deux cas, le visa du COMBORD reste bloqué tant que l'autorité
/// émettrice n'a pas attesté de l'exécution.
model ConsigneAutorite {
  id             String  @id @default(uuid())
  vol_id         String
  vol            Vol     @relation(fields: [vol_id], references: [id], onDelete: Cascade)
  /// Étape d'itinéraire visée. NULL = le vol entier.
  etape_id       String?

  type            TypeConsigne
  autorite        AutoriteCentrale @default(CEMAA)
  /// Contenu chiffré (CemaaCryptoService). Jamais stocké en clair.
  contenu_chiffre String

  places_bloquees  Int     @default(0)
  masse_bloquee_kg Decimal @default(0) @db.Decimal(10, 2)

  emise_par String

  statut_realisation      StatutConsigne @default(EMISE)
  confirme_par            String?
  confirme_le             DateTime?
  observation_realisation String?

  date      DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vol_id, statut_realisation])
  @@index([vol_id, etape_id])
  @@index([autorite, vol_id])
}

// ═══════════════════════════════════════════════════════════════════════════
// Intérim, mouvements, sécurité, archivage
// ═══════════════════════════════════════════════════════════════════════════

model Interim {
  id String @id @default(uuid())

  titulaire_id String
  titulaire    Utilisateur @relation("InterimTitulaire", fields: [titulaire_id], references: [id])
  suppleant_id String
  suppleant    Utilisateur @relation("InterimSuppleant", fields: [suppleant_id], references: [id])

  role_delegue RoleUtilisateur
  base_id      String
  /// RMIA de la délégation, pour les rôles de la chaîne RMIA. Une délégation ne
  /// franchit jamais une frontière de périmètre.
  rmia         Rmia?
  escadron_id  String?

  motif      String?
  date_debut DateTime  @default(now())
  date_fin   DateTime?
  actif      Boolean   @default(true)

  cree_par         String
  revoque_par      String?
  revoque_le       DateTime?
  motif_revocation String?

  visas VisaListe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suppleant_id, actif])
  @@index([titulaire_id, actif])
  @@index([base_id, actif])
  @@index([rmia, actif])
}

model MouvementPersonnel {
  id             String      @id @default(uuid())
  utilisateur_id String
  utilisateur    Utilisateur @relation("MouvementConcerne", fields: [utilisateur_id], references: [id])
  type           TypeMouvement

  base_avant     String?
  base_apres     String?
  role_avant     RoleUtilisateur?
  role_apres     RoleUtilisateur?
  escadron_avant String?
  escadron_apres String?
  rmia_avant     Rmia?
  rmia_apres     Rmia?

  successeur_id String?
  successeur    Utilisateur? @relation("MouvementSuccesseur", fields: [successeur_id], references: [id])

  date_effet DateTime @default(now())
  motif      String?
  reference  String?
  decide_par String
  createdAt  DateTime @default(now())

  @@index([utilisateur_id, date_effet])
  @@index([type, date_effet])
}

model RechercheNominative {
  id           String   @id @default(uuid())
  user_id      String
  role         String
  base_id      String
  type_critere String
  critere      String
  nb_resultats Int      @default(0)
  motif        String?
  ip           String?
  timestamp    DateTime @default(now())

  @@index([user_id, timestamp])
  @@index([timestamp])
}

model AuditLog {
  id           String      @id @default(uuid())
  user_id      String
  utilisateur  Utilisateur @relation(fields: [user_id], references: [id])
  base_id      String
  role         String
  action       String
  resource     String?
  method       String?
  path         String?
  ip           String?
  content_hash String
  timestamp    DateTime    @default(now())

  @@index([user_id, timestamp])
}

model BackupCode {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  code_hash   String
  used        Boolean     @default(false)
  used_at     DateTime?
  created_at  DateTime    @default(now())

  @@index([user_id, used])
  @@map("backup_codes")
}

model KnownDevice {
  id           String      @id @default(uuid())
  user_id      String
  utilisateur  Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  fingerprint  String
  user_agent   String?
  ip           String?
  derniere_vue DateTime    @default(now())
  created_at   DateTime    @default(now())

  @@unique([user_id, fingerprint])
  @@map("known_devices")
}

model SecurityNotification {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type        String
  niveau      String      @default("INFO")
  message     String
  ip          String?
  lu          Boolean     @default(false)
  created_at  DateTime    @default(now())

  @@index([user_id, lu])
  @@index([niveau])
  @@map("security_notifications")
}

model MfaResetRequest {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  motif       String?
  statut      String      @default("EN_ATTENTE")
  traite_par  String?
  traite_le   DateTime?
  created_at  DateTime    @default(now())

  @@index([statut])
  @@map("mfa_reset_requests")
}

model Notification {
  id              String       @id @default(uuid())
  base_id         String
  base            Base         @relation(fields: [base_id], references: [id], onDelete: Cascade)
  destinataire_id String?
  destinataire    Utilisateur? @relation(fields: [destinataire_id], references: [id], onDelete: Cascade)

  /// Diffusion par RMIA. NULL = diffusion par base.
  rmia Rmia?

  type    TypeNotification
  titre   String
  message String

  manifeste_id String?
  vol_id       String?
  liste_id     String?
  etape        String?

  lu        Boolean   @default(false)
  lu_le     DateTime?
  createdAt DateTime  @default(now())

  @@index([base_id, createdAt])
  @@index([rmia, createdAt])
  @@index([destinataire_id, lu])
  @@index([liste_id])
}

model ArchiveManifeste {
  id             String    @id @default(uuid())
  manifeste_id   String    @unique
  manifeste      Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id        String
  vol_id         String
  numero_mission String

  /// Chemin RELATIF à ARCHIVE_ROOT : déplacer le volume ne doit pas invalider
  /// la base.
  chemin          String
  taille_octets   Int
  /// SHA-256 des octets du PDF : intégrité du FICHIER.
  sha256_pdf      String
  /// SHA-256 du CONTENU signé : fait foi sur le fond.
  hash_contenu    String
  version_contenu Int

  statut       StatutArchive @default(DISPONIBLE)
  date_cloture DateTime
  genere_le    DateTime      @default(now())

  nb_telechargements     Int       @default(0)
  dernier_telechargement DateTime?
  derniere_verification  DateTime?

  @@index([base_id, date_cloture])
  @@index([vol_id])
  @@index([statut])
}

model NumeroControle {
  id           String    @id @default(uuid())
  manifeste_id String    @unique
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)

  /// HMAC : recherche inverse en une lecture indexée.
  code_hash    String @unique
  /// Chiffré : seul chemin de ré-affichage à l'administrateur.
  code_chiffre String
  /// 4 derniers caractères en clair, pour le masque public.
  suffixe      String

  genere_le DateTime @default(now())

  nb_verifications      Int       @default(0)
  derniere_verification DateTime?
}
