// SIGEA — Schéma Prisma Principal
// Source de vérité unique — FAC/DSIC/SIGEA-ARCH/2025

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum RoleUtilisateur {
  chef_escale
  /// Commandant des escadrons aeriens. Cree les vols, hors circuit de validation.
  comea
  comeso
  comgmo
  combord
  combase
  cemaa
  /// Major General de l'Armee de l'Air. Autorite centrale, espace propre.
  mage
  admin
}

enum StatutManifeste {
  BROUILLON
  SOUMIS
  EN_VALIDATION
  VALIDE
  REJETE
}

/// Étapes du circuit. L'ordre métier est porté par ETAPE_SEQUENCE
/// (validation-service), PAS par l'ordre de déclaration de cet enum.
/// CEMAA_SENSIBLE est hors séquence : c'est un verrou conditionnel.
enum EtapeValidation {
  CHEF_ESCALE
  COMESO
  COMGMO
  COMBORD
  CEMAA_SENSIBLE
  MAGE_SENSIBLE
  COMBASE
}

enum StatutValidation {
  EN_ATTENTE
  APPROUVE
  REJETE
}

/// Mention portée par le tampon circulaire.
/// VU pour CHEF_ESCALE/COMESO/COMGMO/COMBORD, ACCORD pour COMBASE.
enum MentionSignature {
  VU
  ACCORD
}

enum StatutVol {
  PLANIFIE
  EN_COURS
  CLOTURE
  ANNULE
}

enum CategoriePassager {
  TROUPES
  TROUPES_PARA
  CHEF_MIL
  MISSION
  PERMISSION
  EVASAN
  VIP
  CIVIL
  OP_SENSIBLE
}

enum TypeMission {
  PROJECTION
  PARA
  LIAISON
  LOGISTIQUE
  EVASAN
  VIP
  OP_SENSIBLE
}

enum TypeConsigne {
  PERSONNEL
  MATERIEL
}

enum OrigineEnregistrement {
  SAISIE
  CEMAA
  MAGE
}

enum AutoriteCentrale {
  CEMAA
  MAGE
}

enum TypeMissionLogistique {
  AA
  IA
  INTERMINISTERIEL
  INDIVIDUEL
  SENSIBLE_CEMAA
}

enum FonctionEquipage {
  COMBORD
  COPILOTE
  MECANICIEN
  AUTRE
}

// ── Modèles ──────────────────────────────────────────────────────────────────

model Base {
  id             String         @id @default(uuid())
  code_base      String         @unique
  /// Numéro seul de la base, ex. "101" pour BA101.
  /// Sert à composer les tampons : "COMGMO 102", "COMESCALE 201".
  /// Champ explicite plutôt que dérivé de code_base par slicing.
  numero         String
  nom            String
  region         String
  admin_id       String?
  administrateur Utilisateur?   @relation("BaseAdmin", fields: [admin_id], references: [id])
  utilisateurs   Utilisateur[]
  manifestes     Manifeste[]
  vols_depart    Vol[]          @relation("VolDepart")
  vols_arrivee   Vol[]          @relation("VolArrivee")
  escales        EscaleVol[]    @relation("VolEscale")
  escadrons      Escadron[]
  notifications  Notification[]
  createdAt      DateTime       @default(now())
}

model Utilisateur {
  id                  String                 @id @default(uuid())
  nom                 String
  prenom              String
  grade               String
  login               String                 @unique
  password_hash       String
  role                RoleUtilisateur
  base_id             String
  base                Base                   @relation(fields: [base_id], references: [id])
  escadron_id         String?
  escadron            Escadron?              @relation(fields: [escadron_id], references: [id])
  base_admin          Base[]                 @relation("BaseAdmin")
  actif               Boolean                @default(true)
  last_login          DateTime?
  sessions            Session[]
  validations         ValidationEtape[]
  audits              AuditLog[]
  otp_secret          OtpSecret?
  challenge_token     ChallengeToken?
  email               String?
  mfa_enrolled        Boolean                @default(false)
  verrouille_securite Boolean                @default(false)
  motif_verrouillage  String?
  nb_echecs_connexion Int                    @default(0)
  last_login_ip       String?
  last_login_at       DateTime?
  notif_connexion     Boolean                @default(true)
  notif_par_email     Boolean                @default(false)
  backup_codes        BackupCode[]
  known_devices       KnownDevice[]
  security_notifs     SecurityNotification[]
  mfa_reset_requests  MfaResetRequest[]
  notifications       Notification[]
  interims_titulaire  Interim[]              @relation("InterimTitulaire")
  interims_suppleant  Interim[]              @relation("InterimSuppleant")
  mouvements          MouvementPersonnel[]   @relation("MouvementConcerne")
  successions         MouvementPersonnel[]   @relation("MouvementSuccesseur")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([base_id, role])
  @@index([escadron_id])
}

model OtpSecret {
  id          String      @id @default(uuid())
  user_id     String      @unique
  secret      String
  actif       Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("otp_secrets")
}

model ChallengeToken {
  id          String      @id @default(uuid())
  user_id     String      @unique
  token       String      @unique
  expires_at  DateTime
  created_at  DateTime    @default(now())
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("challenge_tokens")
}

model Session {
  id             String      @id @default(uuid())
  utilisateur_id String
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id])
  refresh_hash   String
  expires_at     DateTime
  createdAt      DateTime    @default(now())
}

model Aeronef {
  id                String   @id @default(uuid())
  immatriculation   String   @unique
  type              String
  capacite_places   Int
  capacite_cargo_kg Decimal  @db.Decimal(10, 2)
  actif             Boolean  @default(true)
  vols              Vol[]
  createdAt         DateTime @default(now())
}

model Unite {
  id   String @id @default(uuid())
  code String @unique
  nom  String
  type String
}

model Vol {
  id                String          @id @default(uuid())
  numero_mission    String          @unique
  immatriculation   String
  aeronef           Aeronef         @relation(fields: [immatriculation], references: [immatriculation])
  date_heure        DateTime
  base_depart_id    String
  base_depart       Base            @relation("VolDepart", fields: [base_depart_id], references: [id])
  base_arrivee_id   String
  base_arrivee      Base            @relation("VolArrivee", fields: [base_arrivee_id], references: [id])
  type_mission      TypeMission
  flag_sensible     Boolean         @default(false)
  capacite_places   Int
  capacite_cargo_kg Decimal         @db.Decimal(10, 2)
  combord_grade     String
  combord_nom       String
  combord_prenom    String
  statut            StatutVol       @default(PLANIFIE)
  escales           EscaleVol[]
  manifestes        Manifeste[]
  consignes_cemaa   ConsigneCemaa[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([date_heure])
  @@index([statut])
  @@index([base_depart_id, base_arrivee_id, date_heure])
  @@index([combord_nom, combord_prenom])
}

/// Escale intermédiaire avec capacités propres.
/// Remplace l'ancien champ `escales_json` (qui n'a jamais existé en base).
model EscaleVol {
  id                String   @id @default(uuid())
  vol_id            String
  vol               Vol      @relation(fields: [vol_id], references: [id], onDelete: Cascade)
  base_id           String
  base              Base     @relation("VolEscale", fields: [base_id], references: [id])
  /// Rang de l'escale sur la route, 1..n.
  ordre             Int
  capacite_places   Int
  capacite_cargo_kg Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  @@unique([vol_id, ordre])
  @@unique([vol_id, base_id])
  @@index([base_id])
}

model ConsigneCemaa {
  id                      String           @id @default(uuid())
  vol_id                  String
  vol                     Vol              @relation(fields: [vol_id], references: [id], onDelete: Cascade)
  escale_base_id          String?
  type                    TypeConsigne
  contenu_chiffre         String
  places_bloquees         Int              @default(0)
  masse_bloquee_kg        Decimal          @default(0) @db.Decimal(10, 2)
  valide_par_cemaa        String
  autorite                AutoriteCentrale @default(CEMAA)
  statut_realisation      StatutConsigne   @default(EMISE)
  confirme_par            String?
  confirme_le             DateTime?
  observation_realisation String?
  date                    DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([vol_id])
  @@index([vol_id, escale_base_id])
  @@index([autorite, vol_id])
  @@index([vol_id, statut_realisation])
}

model Manifeste {
  id                         String           @id @default(uuid())
  vol_id                     String
  vol                        Vol              @relation(fields: [vol_id], references: [id])
  base_id                    String
  base                       Base             @relation(fields: [base_id], references: [id])
  manifeste_maitre_id        String?
  manifeste_maitre           Manifeste?       @relation("ManifestHierarchy", fields: [manifeste_maitre_id], references: [id])
  enfants                    Manifeste[]      @relation("ManifestHierarchy")
  etape_vol                  String           @default("A")
  version                    Int              @default(1)
  statut                     StatutManifeste  @default(BROUILLON)
  etape_courante             EtapeValidation?
  flag_sensible              Boolean          @default(false)
  consignes_cemaa_appliquees Boolean          @default(false)
  consignes_cemaa_date       DateTime?
  consignes_cemaa_nb         Int              @default(0)

  consignes_mage_appliquees Boolean   @default(false)
  consignes_mage_date       DateTime?
  consignes_mage_nb         Int       @default(0)

  cree_par        String
  passagers       Passager[]
  materiels       Materiel[]
  marchandises    MarchandiseDangereuse[]
  equipages       Equipage[]
  validations     ValidationEtape[]
  snapshots       ManifesteSnapshot[]
  alertes         AlerteEscale[]
  compte_rendu    CompteRenduCemaa?
  archive         ArchiveManifeste?
  numero_controle NumeroControle?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([base_id, statut])
  @@index([vol_id, base_id])
}

model Passager {
  id                   String                @id @default(uuid())
  manifeste_id         String
  manifeste            Manifeste             @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id              String
  nom                  String
  prenom               String
  grade                String?
  categorie            CategoriePassager
  matricule            String?
  cni                  String?
  unite                String?
  destination          String
  nb_bagages           Int
  masse_bagages_kg     Decimal               @db.Decimal(7, 2)
  couleur_bagages      String?
  contact_urgence_nom  String
  contact_urgence_tel  String
  contact_urgence_qual String?
  ref_autorisation     String?
  origine              OrigineEnregistrement @default(SAISIE)
  verrouille           Boolean               @default(false)
  sensible             Boolean               @default(false)
  createdAt            DateTime              @default(now())

  @@index([manifeste_id])
  @@index([base_id])
  @@index([cni])
  @@index([matricule])
  @@index([categorie])
  @@index([contact_urgence_tel])
}

model Materiel {
  id                  String                @id @default(uuid())
  manifeste_id        String
  manifeste           Manifeste             @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id             String
  designation         String
  type_mission_log    TypeMissionLogistique
  proprietaire        String
  poids_kg            Decimal               @db.Decimal(10, 2)
  volume              Decimal?              @db.Decimal(10, 3)
  destination         String
  expediteur_nom      String
  expediteur_fonction String
  expediteur_tel      String
  origine             OrigineEnregistrement @default(SAISIE)
  verrouille          Boolean               @default(false)
  sensible            Boolean               @default(false)
  createdAt           DateTime              @default(now())

  @@index([manifeste_id])
  @@index([designation])
  @@index([type_mission_log])
}

model RechercheNominative {
  id           String   @id @default(uuid())
  user_id      String
  role         String
  base_id      String
  /// CNI, MATRICULE, NOM, TELEPHONE
  type_critere String
  critere      String
  nb_resultats Int      @default(0)
  motif        String?
  ip           String?
  timestamp    DateTime @default(now())

  @@index([user_id, timestamp])
  @@index([timestamp])
}

model MarchandiseDangereuse {
  id               String    @id @default(uuid())
  manifeste_id     String
  manifeste        Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  nature           String
  classe_iata      String
  description      String    @db.VarChar(500)
  poids_kg         Decimal   @db.Decimal(10, 2)
  volume           Decimal?  @db.Decimal(10, 3)
  conditionnement  String
  destination      String
  proprietaire     String
  proprietaire_tel String

  @@index([manifeste_id])
}

model Equipage {
  id           String           @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste        @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id      String
  nom          String
  prenom       String
  grade        String
  fonction     FonctionEquipage
}

/// Une ligne par étape franchie. Porte AUSSI le contenu du tampon,
/// figé à l'instant de la signature : un COMGMO muté ne doit pas
/// altérer rétroactivement un manifeste déjà signé.
model ValidationEtape {
  id            String           @id @default(uuid())
  manifeste_id  String
  manifeste     Manifeste        @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  etape         EtapeValidation
  validateur_id String?
  validateur    Utilisateur?     @relation(fields: [validateur_id], references: [id])
  date_heure    DateTime         @default(now())
  commentaire   String?
  statut        StatutValidation @default(EN_ATTENTE)

  // ── Empreinte du tampon (renseignée uniquement si statut = APPROUVE) ──
  /// VU, ou ACCORD pour le COMBASE.
  mention          MentionSignature?
  /// Ligne 1 sous la mention : "COMGMO 102", "COMESCALE 201",
  /// ou le nom du COMBORD, ou le nom du COMBASE.
  tampon_ligne1    String?
  /// Ligne 2 optionnelle : immatriculation pour le COMBORD, code base pour le COMBASE.
  tampon_ligne2    String?
  signataire_nom   String?
  signataire_grade String?

  // -- Interim : le signataire n'etait pas le titulaire du poste --
  /// Vrai si l'etape a ete franchie au titre d'une delegation. Le tampon
  /// porte alors la mention "P/I" et le nom du titulaire empeche.
  par_interim     Boolean  @default(false)
  /// Delegation invoquee. Conserve meme apres revocation : la piste d'audit
  /// doit rester lisible des annees plus tard.
  interim_id      String?
  interim         Interim? @relation(fields: [interim_id], references: [id])
  /// Titulaire empeche, fige a la signature (comme le reste du tampon).
  titulaire_nom   String?
  titulaire_grade String?

  @@unique([manifeste_id, etape], name: "manifeste_id_etape")
  @@index([manifeste_id, etape])
  @@index([statut])
}

model AlerteEscale {
  id            String    @id @default(uuid())
  manifeste_id  String
  manifeste     Manifeste @relation(fields: [manifeste_id], references: [id])
  type_alerte   String
  destinataires String[]
  message       String
  date_emission DateTime  @default(now())
  lu_par        String[]
}

model CompteRenduCemaa {
  id                     String    @id @default(uuid())
  manifeste_id           String    @unique
  manifeste              Manifeste @relation(fields: [manifeste_id], references: [id])
  date_envoi             DateTime  @default(now())
  pdf_chiffre            String
  accuse_reception_cemaa Boolean   @default(false)
}

model AuditLog {
  id           String      @id @default(uuid())
  user_id      String
  utilisateur  Utilisateur @relation(fields: [user_id], references: [id])
  base_id      String
  role         String
  action       String
  resource     String?
  method       String?
  path         String?
  ip           String?
  content_hash String
  timestamp    DateTime    @default(now())

  @@index([user_id, timestamp])
}

model BackupCode {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  code_hash   String
  used        Boolean     @default(false)
  used_at     DateTime?
  created_at  DateTime    @default(now())

  @@index([user_id, used])
  @@map("backup_codes")
}

model KnownDevice {
  id           String      @id @default(uuid())
  user_id      String
  utilisateur  Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  fingerprint  String
  user_agent   String?
  ip           String?
  derniere_vue DateTime    @default(now())
  created_at   DateTime    @default(now())

  @@unique([user_id, fingerprint])
  @@map("known_devices")
}

model SecurityNotification {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type        String
  niveau      String      @default("INFO")
  message     String
  ip          String?
  lu          Boolean     @default(false)
  created_at  DateTime    @default(now())

  @@index([user_id, lu])
  @@index([niveau])
  @@map("security_notifications")
}

model MfaResetRequest {
  id          String      @id @default(uuid())
  user_id     String
  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  motif       String?
  statut      String      @default("EN_ATTENTE")
  traite_par  String?
  traite_le   DateTime?
  created_at  DateTime    @default(now())

  @@index([statut])
  @@map("mfa_reset_requests")
}

/// Notification persistée, rattrapée à la reconnexion WebSocket.
/// Diffusée à la room base:<base_id> ; un destinataire nominatif optionnel
/// (destinataire_id) permet les alertes ciblées (ex. acteurs d'un rejet).
model Notification {
  id              String       @id @default(uuid())
  /// Room de diffusion : tous les utilisateurs de cette base la reçoivent.
  base_id         String
  base            Base         @relation(fields: [base_id], references: [id], onDelete: Cascade)
  /// Destinataire nominatif optionnel. NULL = toute la base.
  destinataire_id String?
  destinataire    Utilisateur? @relation(fields: [destinataire_id], references: [id], onDelete: Cascade)

  type         TypeNotification
  titre        String
  message      String
  /// Contexte applicatif (manifeste_id, vol_id, etape…) pour le clic-vers.
  manifeste_id String?
  vol_id       String?
  etape        String?

  lu        Boolean   @default(false)
  lu_le     DateTime?
  createdAt DateTime  @default(now())

  @@index([base_id, createdAt])
  @@index([destinataire_id, lu])
  @@index([manifeste_id])
}

enum TypeNotification {
  MANIFESTE_SOUMIS
  ETAPE_VALIDEE
  ETAPE_REJETEE
  MANIFESTE_COMPLETE
  CONSIGNE_CEMAA
  ALERTE
}

// ═══════════════════════════════════════════════════════════════════════════
// Historisation du contenu signé
// ═══════════════════════════════════════════════════════════════════════════

/// Instantané immuable du contenu métier d'un manifeste, figé au
/// franchissement d'une étape du circuit.
///
/// ValidationEtape répond à « qui a signé, et quand ». ManifesteSnapshot
/// répond à « sur QUOI ». Sans lui, un manifeste rejeté puis corrigé perd
/// toute trace de l'état sur lequel les signataires amont s'étaient prononcés.
///
/// Aucune écriture après création : ni update, ni delete hors cascade. Deux
/// triggers PostgreSQL le garantissent au niveau du SGBD (voir la migration).
model ManifesteSnapshot {
  id           String    @id @default(uuid())
  manifeste_id String
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)

  /// Étape franchie au moment du figeage. Chaîne libre et non enum : le
  /// circuit peut évoluer, un instantané de 2026 doit rester lisible même si
  /// l'étape correspondante disparaît de EtapeValidation.
  ///
  /// Les passages répétés sur une même étape (rejet, correction, nouveau
  /// rejet) sont suffixés « ETAPE#1 », « ETAPE#2 »… pour ne pas s'écraser.
  etape String

  /// Valeur de Manifeste.version à l'instant du figeage.
  version_contenu Int
  /// Version de l'algorithme de canonicalisation (@sigea/shared-integrity).
  /// Permet de revérifier une empreinte ancienne avec l'algorithme de son époque.
  version_format  Int @default(1)

  /// SHA-256 hexadécimal du payload canonique.
  hash    String
  /// Forme canonique intégrale, conservée pour l'expertise : elle permet de
  /// rejouer le calcul et de montrer ce qui a été signé, pas seulement de
  /// constater une divergence.
  payload String

  validateur_id String?
  createdAt     DateTime @default(now())

  @@unique([manifeste_id, etape], name: "manifeste_id_etape")
  @@index([manifeste_id, createdAt])
  @@index([hash])
}

// ═══════════════════════════════════════════════════════════════════════════
// Escadrons aériens
// ═══════════════════════════════════════════════════════════════════════════

/// Escadron aérien rattaché à une base. Une base porte 0..n escadrons.
///
/// Le rôle COMEA est le commandant d'UN escadron : c'est la raison d'être de
/// ce modèle. La création d'un utilisateur COMEA impose donc le choix d'un
/// escadron, et ce choix est borné aux escadrons de sa base d'affectation.
model Escadron {
  id           String        @id @default(uuid())
  /// Numéro seul, tel qu'il se dit : "21", "22", "31"… Sert aux libellés et
  /// au tampon éventuel. Unique DANS une base, pas globalement : deux bases
  /// peuvent héberger des escadrons de numérotation voisine.
  code         String
  nom          String
  /// Vocation opérationnelle : TRANSPORT, CHASSE, HELICOPTERE, ECOLE…
  /// Chaîne libre et non enum : la nomenclature évolue par décision d'emploi,
  /// pas par migration de schéma.
  type         String?
  base_id      String
  base         Base          @relation(fields: [base_id], references: [id])
  actif        Boolean       @default(true)
  utilisateurs Utilisateur[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([base_id, code])
  @@index([base_id, actif])
}

// ═══════════════════════════════════════════════════════════════════════════
// Intérim et mouvements de personnel
// ═══════════════════════════════════════════════════════════════════════════

/// Délégation temporaire des attributions d'un poste.
///
/// Principe retenu : on NE MODIFIE PAS le rôle du suppléant. Il conserve le
/// sien et reçoit, le temps de l'intérim, les attributions du rôle délégué.
/// Un COMESO couvrant le COMGMO peut ainsi signer les deux étapes, ce qu'une
/// simple bascule de rôle rendrait impossible.
///
/// Contrainte assumée : titulaire et suppléant appartiennent à la MÊME base.
/// Le cloisonnement par base_id du jeton reste donc intact — aucune étape du
/// circuit ne peut être franchie hors du périmètre du signataire.
model Interim {
  id String @id @default(uuid())

  /// Titulaire empêché. Ses attributions sont déléguées, son compte reste actif.
  titulaire_id String
  titulaire    Utilisateur @relation("InterimTitulaire", fields: [titulaire_id], references: [id])

  /// Suppléant. Exerce le rôle délégué EN PLUS du sien.
  suppleant_id String
  suppleant    Utilisateur @relation("InterimSuppleant", fields: [suppleant_id], references: [id])

  /// Rôle effectivement délégué. Figé : si le titulaire est muté et change de
  /// rôle, l'intérim en cours ne suit pas — il doit être révoqué explicitement.
  role_delegue RoleUtilisateur
  base_id      String
  escadron_id  String?

  motif      String?
  date_debut DateTime  @default(now())
  /// NULL = durée indéterminée, jusqu'à révocation explicite.
  date_fin   DateTime?

  /// Drapeau de révocation. La borne temporelle (date_fin) ne suffit pas :
  /// l'administrateur doit pouvoir couper un accès dans la seconde, sans
  /// attendre l'échéance. L'index partiel ci-dessous s'appuie dessus.
  actif Boolean @default(true)

  cree_par         String
  revoque_par      String?
  revoque_le       DateTime?
  motif_revocation String?

  /// Signatures apposées au titre de cette délégation.
  validations ValidationEtape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suppleant_id, actif])
  @@index([titulaire_id, actif])
  @@index([base_id, actif])
}

enum TypeMouvement {
  MUTATION
  DEPART
  SUSPENSION
  REINTEGRATION
}

/// Suivi d'exécution d'une consigne d'autorité centrale.
enum StatutConsigne {
  /// Émise, exécution non encore confirmée. Bloque le circuit.
  EMISE
  /// L'autorité émettrice atteste que la consigne a été exécutée.
  REALISEE
  /// L'autorité constate que la consigne N'A PAS été exécutée.
  /// Bloque le circuit jusqu'à correction du manifeste et nouvelle confirmation.
  NON_REALISEE
  /// Consigne retirée par son émetteur. Ne bloque plus rien.
  ANNULEE
}

/// Journal des mouvements de personnel : mutation, départ, suspension.
///
/// Distinct d'AuditLog, qui trace les APPELS. Ici on trace une DÉCISION
/// d'emploi : qui remplace qui, à quelle date d'effet, sur décision de qui.
/// C'est cette table que l'on produit lorsqu'il faut justifier, deux ans plus
/// tard, pourquoi tel compte a cessé de signer tel jour.
model MouvementPersonnel {
  id             String        @id @default(uuid())
  utilisateur_id String
  utilisateur    Utilisateur   @relation("MouvementConcerne", fields: [utilisateur_id], references: [id])
  type           TypeMouvement

  base_avant     String?
  base_apres     String?
  role_avant     RoleUtilisateur?
  role_apres     RoleUtilisateur?
  escadron_avant String?
  escadron_apres String?

  /// Successeur désigné, le cas échéant. Purement documentaire : le transfert
  /// effectif des attributions passe par la mise à jour du compte du
  /// successeur, pas par ce champ.
  successeur_id String?
  successeur    Utilisateur? @relation("MouvementSuccesseur", fields: [successeur_id], references: [id])

  date_effet DateTime @default(now())
  motif      String?
  reference  String?
  decide_par String
  createdAt  DateTime @default(now())

  @@index([utilisateur_id, date_effet])
  @@index([type, date_effet])
}

enum StatutArchive {
  DISPONIBLE
  ABSENT
  CORROMPU
}

/// Archive PDF d'un manifeste dont le circuit est clos.
///
/// ── Stratégie retenue : stocker ET pouvoir régénérer ──
/// Le fichier est écrit sur volume au moment où le circuit se clôt, et son
/// empreinte est conservée. À la demande de téléchargement, l'empreinte est
/// revérifiée ; si le fichier manque ou diverge, le PDF est régénéré depuis
/// l'instantané — mais le téléchargement est alors marqué comme SECOURS,
/// jamais présenté comme l'original.
///
/// Pourquoi les deux plutôt que l'un des deux :
///   • le stockage seul repose sur la seule intégrité du volume, et un
///     manifeste de 2026 doit rester lisible en 2036 ;
///   • la régénération seule suppose que Chromium, les polices et le gabarit
///     produiront dans dix ans le même document qu'aujourd'hui. C'est faux :
///     un PDF régénéré n'est jamais octet pour octet identique à l'original.
///
/// ── Ce que l'empreinte prouve, et ce qu'elle ne prouve pas ──
/// `sha256_pdf` atteste que le fichier servi est bien celui qui a été archivé.
/// Elle NE PERMET PAS de comparer un original à une régénération : deux rendus
/// du même contenu diffèrent (horodatage interne, sous-ensembles de polices).
/// La correspondance au CONTENU signé se vérifie par `hash_contenu`, repris de
/// ManifesteSnapshot — c'est lui, et lui seul, qui fait foi sur le fond.
model ArchiveManifeste {
  id             String    @id @default(uuid())
  manifeste_id   String    @unique
  manifeste      Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)
  base_id        String
  vol_id         String
  numero_mission String
  etape_vol      String

  /// Chemin RELATIF à ARCHIVE_ROOT, ex. « 2026/08/uuid.pdf ».
  /// Relatif et non absolu : déplacer le volume ne doit pas invalider la base.
  chemin          String
  taille_octets   Int
  /// SHA-256 des octets du PDF archivé. Contrôle d'intégrité du FICHIER.
  sha256_pdf      String
  /// SHA-256 du CONTENU signé, repris de ManifesteSnapshot. Fait foi sur le fond.
  hash_contenu    String
  version_contenu Int

  statut       StatutArchive @default(DISPONIBLE)
  /// Date de clôture du circuit — celle qui a du sens pour un archiviste,
  /// et non la date d'écriture du fichier, qui n'est qu'un détail technique.
  date_cloture DateTime
  genere_le    DateTime      @default(now())

  nb_telechargements     Int       @default(0)
  dernier_telechargement DateTime?
  /// Horodatage de la dernière vérification d'empreinte réussie.
  derniere_verification  DateTime?

  @@index([base_id, date_cloture])
  @@index([vol_id])
  @@index([statut])
}

/// Numéro de contrôle imprimé sous le code QR d'un manifeste.
///
/// Le QR atteste que le CONTENU est authentique. Il n'atteste pas que
/// l'exemplaire présenté est le bon : un manifeste valide photographié se
/// réimprime avec un QR qui se vérifie parfaitement. Le numéro de contrôle
/// ferme cette porte — il est tiré au hasard, imprimé sur le document, et
/// n'est jamais renvoyé en clair par l'endpoint public de vérification.
///
/// Trois représentations, trois usages distincts :
///   • code_hash    — HMAC. Recherche inverse en une lecture indexée.
///   • code_chiffre — chiffré (CemaaCryptoService). Seul chemin de
///                    re-affichage à l'administrateur ; une empreinte ne se
///                    renverse pas.
///   • suffixe      — 4 derniers caractères en clair, pour le masque public
///                    (« •••• ••• 4B7C ») : comparable de visu, insuffisant
///                    pour reconstituer le numéro.
///
/// Immuable après émission : deux triggers PostgreSQL le garantissent au
/// niveau du SGBD (voir la migration). Seuls les compteurs de vérification
/// évoluent.
model NumeroControle {
  id           String    @id @default(uuid())
  manifeste_id String    @unique
  manifeste    Manifeste @relation(fields: [manifeste_id], references: [id], onDelete: Cascade)

  /// HMAC du numéro. Unique : deux manifestes portant le même numéro
  /// rendraient la recherche inverse ambiguë au moment où elle doit trancher.
  code_hash    String @unique
  /// Numéro chiffré. Permet la révélation à l'administrateur, et elle seule.
  code_chiffre String
  /// 4 derniers caractères, en clair, pour le masque affiché publiquement.
  suffixe      String

  /// Étape à laquelle le numéro a été émis. Documentaire : sert à comprendre
  /// pourquoi un manifeste ancien n'en porte pas.
  genere_etape String?
  genere_le    DateTime @default(now())

  nb_verifications      Int       @default(0)
  derniere_verification DateTime?
}
