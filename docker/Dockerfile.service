FROM node:20-alpine AS builder
ARG SERVICE
WORKDIR /app

COPY package*.json ./
# Résolution des alias @sigea/* vers les SOURCES pour la compilation conteneur.
# (Le workspace Nx continue de viser dist/libs/* via le vrai tsconfig.base.json ;
#  on ne substitue le fichier QUE dans l'image.)
COPY docker/tsconfig.docker-base.json ./tsconfig.base.json

RUN npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-retries 5 \
    && npm ci --ignore-scripts

RUN npm install -g tsc-alias

COPY prisma ./prisma
RUN PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 \
    npx prisma generate --schema=prisma/schema.prisma

COPY apps/${SERVICE} ./apps/${SERVICE}
COPY libs ./libs

RUN npx tsc --project apps/${SERVICE}/tsconfig.app.json --noEmit false && \
    tsc-alias --project apps/${SERVICE}/tsconfig.app.json

# ── Runner ────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
ARG SERVICE
ENV SERVICE=${SERVICE}

# openssl : requis par Prisma. Chromium : uniquement pour le pdf-service
# (Puppeteer), car `npm ci --ignore-scripts` ne télécharge pas son Chrome.
RUN apk add --no-cache openssl && \
    addgroup -g 1001 -S nodejs && adduser -S sigea -u 1001 && \
    if [ "$SERVICE" = "pdf-service" ]; then \
      apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont && \
      { [ -e /usr/bin/chromium-browser ] || ln -sf /usr/bin/chromium /usr/bin/chromium-browser; }; \
    fi

# Puppeteer utilisera le Chromium système au lieu de tenter un téléchargement.
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /app

COPY --from=builder --chown=sigea:nodejs /app/dist/out-tsc ./dist
COPY --from=builder --chown=sigea:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=sigea:nodejs /app/prisma ./prisma
COPY --from=builder --chown=sigea:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=sigea:nodejs /app/node_modules/@prisma/client ./node_modules/@prisma/client

RUN mkdir -p /var/lib/sigvea/archives && chown -R sigea:nodejs /var/lib/sigvea
USER sigea
EXPOSE ${PORT:-3000}

CMD ["sh", "-c", "node dist/apps/${SERVICE}/src/main.js"]